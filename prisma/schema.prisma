generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ItemDiscipline {
  MECHANICAL
  ELECTRONICS
}

enum UserRole {
  SUPER_ADMIN
  INVENTORY_MANAGER
  PURCHASE_APPROVER
  USER
}

enum ProcurementType {
  FOREIGN_STANDARD
  FOREIGN_MANUFACTURED
  LOCAL_STANDARD
  LOCAL_MANUFACTURED
}

enum ItemCatalogueState {
  COMPLETE
  INCOMPLETE
}

enum DemandState {
  SUBMITTED
  ACTIVE
  CLOSED
  CANCELLED
}

enum ReservationEntryType {
  RESERVE
  RELEASE
}

enum InventoryLedgerEntryType {
  OPENING
  RECEIPT
  ISSUE
  RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum DemandApprovalRevisionType {
  MANAGER_ADJUSTMENT
  PROCUREMENT_TO_STOCK
  RETURN_NO_REPLACEMENT
  CANCELLATION
}

enum ReturnDisposition {
  REPLACEMENT_REQUIRED
  REDUCE_APPROVED_QUANTITY
}

enum PurchaseRequestStatus {
  BACKLOG
  PENDING_ORDER_APPROVAL
  ORDERED
  SHIPPED
  RECEIVED_IN_STORE
}

enum AttachmentKind {
  RECEIPT
  INVOICE
  QUOTATION
  SHIPPING_DOCUMENT
  OTHER
}

enum CargoRoute {
  DIRECT
  FORWARDED
}

enum CargoStage {
  AT_VENDOR
  TO_SOURCE_WAREHOUSE
  AT_SOURCE_WAREHOUSE
  IN_INTERNATIONAL_TRANSIT
  ARRIVED_IN_COUNTRY
  CUSTOMS_PENDING
  CUSTOMS_CLEARED
  OUT_FOR_DELIVERY
  RECEIVED
}

enum CargoLegKind {
  SOURCE_INLAND
  INTERNATIONAL
  CUSTOMS
  DESTINATION_INLAND
}

enum CargoChargeCategory {
  SOURCE_INLAND
  INTERNATIONAL_FREIGHT
  CUSTOMS_DUTY
  CUSTOMS_CLEARANCE
  DESTINATION_INLAND
  HANDLING
  OTHER
}

enum CargoFileKind {
  CONTENT_PHOTO
  CARTON_PHOTO
  INVOICE
  RECEIPT
  SHIPPING_DOCUMENT
  OTHER
}

enum ProcurementOrderStatus {
  DRAFT
  PLACED
  PAID
  SUPPLIER_SHIPPED
  RECEIVED
  CLOSED
  CANCELLED
}

enum SupplyMode {
  BUY
  MAKE
  MAKE_OR_BUY
}

enum TrackingMode {
  QUANTITY
  LOT
  SERIAL
}

enum DefinitionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ProductionPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum ProductionResourceType {
  CNC_MACHINE
  LATHE
  MILL
  THREE_D_PRINTER
  REFLOW_OVEN
  TEST_BENCH
  ASSEMBLY_STATION
  OTHER
}

enum ProductionResourceStatus {
  AVAILABLE
  UNAVAILABLE
  RETIRED
}

enum RouteExecutionMode {
  INTERNAL
  SUBCONTRACTED
}

enum RouteTransitionType {
  NORMAL
  REWORK
  ALTERNATIVE
}

enum RouteStepRequirementType {
  OPERATOR
  RESOURCE
  VENDOR
  MATERIAL_LOT
  QUALITY_INSPECTION
  TEXT
  NUMBER
  DATE
}

enum RouteStepRequirementCapturePoint {
  START
  COMPLETE
  TRANSITION
}

model User {
  id                           String                    @id @default(cuid())
  email                        String                    @unique
  password                     String
  name                         String
  status                       String                    @default("ACTIVE")
  role                         UserRole                  @default(USER)
  phone                        String?
  avatar                       String?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  itemsCreated                 Item[]                    @relation("ItemCreatedBy")
  procurementOrderPackageLinks ProcurementOrderPackage[] @relation("ProcurementOrderPackageLinkedBy")
  demandsRequested             Demand[]                  @relation("DemandRequestedBy")
  demandsStarted               Demand[]                  @relation("DemandStartedBy")
  demandsClosed                Demand[]                  @relation("DemandClosedBy")
  demandsCancelled             Demand[]                  @relation("DemandCancelledBy")
  reservationsCreated          DemandReservationEntry[]  @relation("ReservationCreatedBy")
  cancellationsCreated         DemandLineCancellation[]  @relation("CancellationCreatedBy")
  demandLinesApproved          DemandLine[]              @relation("DemandLineApprovedBy")
  approvalRevisions            DemandApprovalRevision[]  @relation("ApprovalRevisionCreatedBy")
  issuesPosted                 DemandIssue[]             @relation("IssuePostedBy")
  returnsPosted                DemandReturn[]            @relation("ReturnPostedBy")
  ledgerEntries                InventoryLedgerEntry[]    @relation("LedgerActor")
  purchaseRequests             PurchaseRequest[]         @relation("PurchaseCreatedBy")
  receiptsPosted               GoodsReceipt[]            @relation("ReceiptPostedBy")
  adjustmentsPosted            InventoryAdjustment[]     @relation("AdjustmentPostedBy")
  attachmentsUploaded          Attachment[]              @relation("AttachmentUploadedBy")
  auditLogs                    AuditLog[]
  accessGroups                 UserAccessGroup[]
  cargoShipmentsCreated        CargoShipment[]           @relation("CargoShipmentCreatedBy")
  cargoMilestonesPosted        CargoMilestone[]          @relation("CargoMilestonePostedBy")
  cargoInvoicesCreated         CargoInvoice[]            @relation("CargoInvoiceCreatedBy")
  cargoChargesCreated          CargoCharge[]             @relation("CargoChargeCreatedBy")
  cargoFilesUploaded           CargoFile[]               @relation("CargoFileUploadedBy")
  serviceTokens                ServiceToken[]
  cargoRequestKeys             CargoRequestKey[]
  apiRequestKeys               ApiRequestKey[]
  procurementOrdersCreated     ProcurementOrder[]        @relation("ProcurementOrderCreatedBy")
  billOfMaterialsCreated       BillOfMaterial[]          @relation("BillOfMaterialCreatedBy")
  bomVersionsCreated           BomVersion[]              @relation("BomVersionCreatedBy")
  bomVersionsApproved          BomVersion[]              @relation("BomVersionApprovedBy")
  manufacturingRoutesCreated   ManufacturingRoute[]      @relation("ManufacturingRouteCreatedBy")
  routeVersionsCreated         RouteVersion[]            @relation("RouteVersionCreatedBy")
  routeVersionsApproved        RouteVersion[]            @relation("RouteVersionApprovedBy")
  productionPlansCreated       ProductionPlan[]          @relation("ProductionPlanCreatedBy")
  productionOrdersCreated      ProductionOrder[]         @relation("ProductionOrderCreatedBy")
  productionOrdersReleased     ProductionOrder[]         @relation("ProductionOrderReleasedBy")
}

model ServiceToken {
  id         String    @id
  userId     String
  name       String
  tokenHash  String    @unique @db.VarChar(64)
  scopes     String[]
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("service_tokens")
}

model CargoRequestKey {
  actorId     String
  key         String
  action      String
  requestHash String   @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@id([actorId, key])
  @@map("cargo_request_keys")
}

// Shared idempotency record for consequential APIs outside Cargo. The request
// hash and stored response make safe retries explicit without coupling future
// modules to a Cargo-named table.
model ApiRequestKey {
  actorId     String   @map("actor_id")
  key         String
  action      String
  requestHash String   @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@id([actorId, key])
  @@index([createdAt])
  @@map("api_request_keys")
}

model Permission {
  key         String                  @id
  module      String
  description String
  groups      AccessGroupPermission[]

  @@map("permissions")
}

model AccessGroup {
  id          String                  @id
  name        String                  @unique
  description String
  isSystem    Boolean                 @default(false)
  permissions AccessGroupPermission[]
  users       UserAccessGroup[]

  @@map("access_groups")
}

model AccessGroupPermission {
  groupId       String
  permissionKey String
  group         AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([groupId, permissionKey])
  @@map("access_group_permissions")
}

model UserAccessGroup {
  userId  String
  groupId String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@map("user_access_groups")
}

model DepartmentTag {
  id             String       @id @default(cuid())
  name           String
  normalizedName String       @unique
  code           String?      @unique
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  demands        Demand[]

  @@index([name])
  @@map("department_tags")
}

model ProjectTag {
  id               String            @id @default(cuid())
  name             String
  normalizedName   String            @unique
  code             String?           @unique
  description      String?
  status           RecordStatus      @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  demandLines      DemandLine[]
  billOfMaterials  BillOfMaterial[]
  productionPlans  ProductionPlan[]
  productionOrders ProductionOrder[]

  @@index([name])
  @@map("project_tags")
}

model ItemCategory {
  id             String         @id @default(cuid())
  name           String
  normalizedName String
  discipline     ItemDiscipline
  parentId       String?
  description    String?
  status         RecordStatus   @default(ACTIVE)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  parent         ItemCategory?  @relation("ItemCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       ItemCategory[] @relation("ItemCategoryTree")
  items          Item[]
  demandLines    DemandLine[]   @relation("SuggestedDemandCategory")

  @@unique([parentId, normalizedName])
  @@index([discipline, status, sortOrder])
  @@map("item_categories")
}

model Vendor {
  id                String             @id @default(cuid())
  name              String
  normalizedName    String             @unique
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  remarks           String?
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  demandLines       DemandLine[]
  purchaseRequests  PurchaseRequest[]
  cargoPackages     CargoPackage[]
  procurementOrders ProcurementOrder[]
  supplierLinks     ItemSupplierLink[]

  @@index([name])
  @@map("vendors")
}

model Item {
  id                        String                     @id @default(cuid())
  code                      String                     @unique
  title                     String
  discipline                ItemDiscipline
  categoryId                String?
  catalogueState            ItemCatalogueState         @default(COMPLETE)
  description               String?
  specification             String?
  manufacturerName          String?
  manufacturerPartNumber    String?
  supplierPartNumber        String?
  function                  String?
  link                      String?
  optionSelection           String?
  remarks                   String?
  unit                      String                     @default("pcs")
  status                    RecordStatus               @default(ACTIVE)
  importSourceKey           String?                    @unique
  createdById               String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  category                  ItemCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy                 User?                      @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  balance                   ItemBalance?
  demandLines               DemandLine[]
  issueLines                DemandIssueLine[]
  returnLines               DemandReturnLine[]
  ledgerEntries             InventoryLedgerEntry[]
  purchaseLines             PurchaseRequestLine[]
  supplierLinks             ItemSupplierLink[]
  receiptLines              GoodsReceiptLine[]
  procurementOrderLines     ProcurementOrderLine[]
  productionPlanLines       ProductionPlanLine[]
  productionOrders          ProductionOrder[]
  productionOrderComponents ProductionOrderComponent[]
  adjustmentLines           InventoryAdjustmentLine[]
  manufacturingProfile      ManufacturingProfile?
  manufacturedBoms          BillOfMaterial[]           @relation("BillOfMaterialOutputItem")
  bomComponentLines         BomLine[]                  @relation("BomLineComponentItem")
  manufacturingRoutes       ManufacturingRoute[]

  @@index([title])
  @@index([categoryId, status])
  @@index([manufacturerPartNumber])
  @@index([supplierPartNumber])
  @@index([status])
  @@map("items")
}

model ItemBalance {
  itemId    String   @id
  onHand    Decimal  @default(0) @db.Decimal(18, 6)
  reserved  Decimal  @default(0) @db.Decimal(18, 6)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_balances")
}

/// A catalogue-level supplier reference. This is procurement metadata only: it
/// never establishes stock, price, allocation, or a purchase order.
model ItemSupplierLink {
  id                 String   @id @default(cuid())
  itemId             String
  vendorId           String?
  url                String
  supplierPartNumber String?
  notes              String?
  isPreferred        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor             Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([itemId, url])
  @@index([vendorId])
  @@index([itemId, isPreferred])
  @@map("item_supplier_links")
}

// Manufacturing definitions are optional Item configuration. Purchased items
// deliberately have no profile unless their supply/trace policy needs one.
model ManufacturingProfile {
  id                     String        @id @default(cuid())
  itemId                 String        @unique
  supplyMode             SupplyMode
  trackingMode           TrackingMode  @default(QUANTITY)
  defaultBomVersionId    String?
  defaultRouteVersionId  String?
  traceInFinishedProduct Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  item                   Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  defaultBomVersion      BomVersion?   @relation("ManufacturingProfileDefaultBomVersion", fields: [defaultBomVersionId], references: [id], onDelete: SetNull)
  defaultRouteVersion    RouteVersion? @relation("ManufacturingProfileDefaultRouteVersion", fields: [defaultRouteVersionId], references: [id], onDelete: SetNull)

  @@map("manufacturing_profiles")
}

model BillOfMaterial {
  id           String       @id @default(cuid())
  itemId       String
  projectTagId String?
  name         String
  status       RecordStatus @default(ACTIVE)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  item         Item         @relation("BillOfMaterialOutputItem", fields: [itemId], references: [id], onDelete: Restrict)
  projectTag   ProjectTag?  @relation(fields: [projectTagId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("BillOfMaterialCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  versions     BomVersion[]

  @@index([itemId, status])
  @@index([projectTagId, status])
  @@map("bill_of_materials")
}

model BomVersion {
  id                 String                 @id @default(cuid())
  bomId              String
  revision           String
  status             DefinitionStatus       @default(DRAFT)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  createdById        String
  approvedAt         DateTime?
  approvedById       String?
  createdAt          DateTime               @default(now())
  bom                BillOfMaterial         @relation(fields: [bomId], references: [id], onDelete: Restrict)
  createdBy          User                   @relation("BomVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy         User?                  @relation("BomVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  lines              BomLine[]
  defaultForProfiles ManufacturingProfile[] @relation("ManufacturingProfileDefaultBomVersion")
  productionOrders   ProductionOrder[]

  @@unique([bomId, revision])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("bom_versions")
}

model BomLine {
  id                     String     @id @default(cuid())
  bomVersionId           String
  itemId                 String
  parentLineId           String?
  sourceLineKey          String
  quantity               Decimal    @db.Decimal(18, 6)
  unit                   String?
  scrapAllowance         Decimal?   @db.Decimal(18, 6)
  consumptionRouteStepId String?
  notes                  String?
  sortOrder              Int        @default(0)
  createdAt              DateTime   @default(now())
  bomVersion             BomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)
  item                   Item       @relation("BomLineComponentItem", fields: [itemId], references: [id], onDelete: Restrict)
  parentLine             BomLine?   @relation("BomLineHierarchy", fields: [parentLineId, bomVersionId], references: [id, bomVersionId], onDelete: Restrict)
  childLines             BomLine[]  @relation("BomLineHierarchy")
  consumptionRouteStep   RouteStep? @relation("BomLineConsumptionRouteStep", fields: [consumptionRouteStepId], references: [id], onDelete: SetNull)

  @@unique([id, bomVersionId])
  @@unique([bomVersionId, sourceLineKey])
  @@index([bomVersionId, sortOrder])
  @@index([itemId])
  @@map("bom_lines")
}

model WorkCenter {
  id                   String                   @id @default(cuid())
  code                 String                   @unique
  name                 String
  description          String?
  status               RecordStatus             @default(ACTIVE)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  operations           ManufacturingOperation[] @relation("OperationDefaultWorkCenter")
  resources            ProductionResource[]
  routeSteps           RouteStep[]
  productionOperations ProductionOperation[]

  @@index([status, name])
  @@map("work_centers")
}

model ProductionResource {
  id           String                   @id @default(cuid())
  code         String                   @unique
  name         String
  resourceType ProductionResourceType
  workCenterId String?
  status       ProductionResourceStatus @default(AVAILABLE)
  metadata     Json?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  workCenter   WorkCenter?              @relation(fields: [workCenterId], references: [id], onDelete: SetNull)

  @@index([workCenterId, status])
  @@index([resourceType, status])
  @@map("production_resources")
}

model ManufacturingOperation {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  description          String?
  defaultWorkCenterId  String?
  status               RecordStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  defaultWorkCenter    WorkCenter?           @relation("OperationDefaultWorkCenter", fields: [defaultWorkCenterId], references: [id], onDelete: SetNull)
  routeSteps           RouteStep[]
  productionOperations ProductionOperation[]

  @@index([status, name])
  @@map("manufacturing_operations")
}

model ManufacturingRoute {
  id          String         @id @default(cuid())
  itemId      String?
  name        String
  description String?
  status      RecordStatus   @default(ACTIVE)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  item        Item?          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("ManufacturingRouteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  versions    RouteVersion[]

  @@index([itemId, status])
  @@map("manufacturing_routes")
}

model RouteVersion {
  id                 String                 @id @default(cuid())
  routeId            String
  revision           String
  status             DefinitionStatus       @default(DRAFT)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  createdById        String
  approvedAt         DateTime?
  approvedById       String?
  createdAt          DateTime               @default(now())
  route              ManufacturingRoute     @relation(fields: [routeId], references: [id], onDelete: Restrict)
  createdBy          User                   @relation("RouteVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy         User?                  @relation("RouteVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  steps              RouteStep[]
  transitions        RouteTransition[]
  defaultForProfiles ManufacturingProfile[] @relation("ManufacturingProfileDefaultRouteVersion")
  productionOrders   ProductionOrder[]

  @@unique([routeId, revision])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("route_versions")
}

model RouteStep {
  id                   String                 @id @default(cuid())
  routeVersionId       String
  operationId          String
  sequence             Int
  nameOverride         String?
  workCenterId         String?
  executionMode        RouteExecutionMode     @default(INTERNAL)
  isSerializationPoint Boolean                @default(false)
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  routeVersion         RouteVersion           @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  operation            ManufacturingOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  workCenter           WorkCenter?            @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  requirements         RouteStepRequirement[]
  outgoingTransitions  RouteTransition[]      @relation("RouteTransitionFrom")
  incomingTransitions  RouteTransition[]      @relation("RouteTransitionTo")
  consumedBomLines     BomLine[]              @relation("BomLineConsumptionRouteStep")

  @@unique([id, routeVersionId])
  @@unique([routeVersionId, sequence])
  @@index([operationId])
  @@index([workCenterId])
  @@map("route_steps")
}

model RouteTransition {
  id             String              @id @default(cuid())
  routeVersionId String
  fromStepId     String
  toStepId       String
  transitionType RouteTransitionType @default(NORMAL)
  createdAt      DateTime            @default(now())
  routeVersion   RouteVersion        @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  fromStep       RouteStep           @relation("RouteTransitionFrom", fields: [fromStepId, routeVersionId], references: [id, routeVersionId], onDelete: Restrict)
  toStep         RouteStep           @relation("RouteTransitionTo", fields: [toStepId, routeVersionId], references: [id, routeVersionId], onDelete: Restrict)

  @@unique([routeVersionId, fromStepId, toStepId, transitionType])
  @@index([routeVersionId, fromStepId])
  @@map("route_transitions")
}

model RouteStepRequirement {
  id              String                           @id @default(cuid())
  routeStepId     String
  requirementType RouteStepRequirementType
  key             String
  label           String
  requiredAt      RouteStepRequirementCapturePoint
  required        Boolean                          @default(false)
  allowMultiple   Boolean                          @default(false)
  sequence        Int                              @default(0)
  createdAt       DateTime                         @default(now())
  routeStep       RouteStep                        @relation(fields: [routeStepId], references: [id], onDelete: Restrict)

  @@unique([routeStepId, key])
  @@index([routeStepId, sequence])
  @@map("route_step_requirements")
}

// Planning and released-order snapshots. Execution/WIP is deliberately added in
// a later phase; a released order never re-reads mutable BOM or route records.
model ProductionPlan {
  id           String               @id @default(cuid())
  projectTagId String
  name         String
  status       ProductionPlanStatus @default(DRAFT)
  notes        String?
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  projectTag   ProjectTag           @relation(fields: [projectTagId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("ProductionPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines        ProductionPlanLine[]

  @@index([projectTagId, status])
  @@map("production_plans")
}

model ProductionPlanLine {
  id               String            @id @default(cuid())
  productionPlanId String
  itemId           String
  targetQty        Decimal           @db.Decimal(18, 6)
  requiredDate     DateTime?
  priority         Int?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  productionPlan   ProductionPlan    @relation(fields: [productionPlanId], references: [id], onDelete: Restrict)
  item             Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  productionOrders ProductionOrder[]

  @@unique([productionPlanId, itemId])
  @@index([itemId])
  @@map("production_plan_lines")
}

model ProductionOrder {
  id                   String                     @id @default(cuid())
  orderNumber          String                     @unique
  projectTagId         String
  productionPlanLineId String?
  itemId               String
  plannedQty           Decimal                    @db.Decimal(18, 6)
  bomVersionId         String?
  routeVersionId       String?
  status               ProductionOrderStatus      @default(DRAFT)
  plannedStart         DateTime?
  plannedEnd           DateTime?
  actualStart          DateTime?
  completedAt          DateTime?
  createdById          String
  releasedAt           DateTime?
  releasedById         String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  projectTag           ProjectTag                 @relation(fields: [projectTagId], references: [id], onDelete: Restrict)
  productionPlanLine   ProductionPlanLine?        @relation(fields: [productionPlanLineId], references: [id], onDelete: Restrict)
  item                 Item                       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  bomVersion           BomVersion?                @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)
  routeVersion         RouteVersion?              @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  createdBy            User                       @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy           User?                      @relation("ProductionOrderReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  components           ProductionOrderComponent[]
  operations           ProductionOperation[]

  @@index([projectTagId, status])
  @@index([itemId, status])
  @@index([productionPlanLineId])
  @@map("production_orders")
}

model ProductionOrderComponent {
  id                  String          @id @default(cuid())
  productionOrderId   String
  sourceBomLineId     String?
  itemId              String
  requiredQty         Decimal         @db.Decimal(18, 6)
  consumptionSequence Int?
  createdAt           DateTime        @default(now())
  productionOrder     ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  item                Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([productionOrderId, sourceBomLineId])
  @@index([itemId])
  @@map("production_order_components")
}

model ProductionOperation {
  id                   String                 @id @default(cuid())
  productionOrderId    String
  sourceRouteStepId    String?
  operationId          String
  sequence             Int
  name                 String
  workCenterId         String?
  executionMode        RouteExecutionMode
  isSerializationPoint Boolean                @default(false)
  createdAt            DateTime               @default(now())
  productionOrder      ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  operation            ManufacturingOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  workCenter           WorkCenter?            @relation(fields: [workCenterId], references: [id], onDelete: SetNull)

  @@unique([productionOrderId, sequence])
  @@index([operationId])
  @@map("production_operations")
}

model Demand {
  id                 String         @id @default(cuid())
  demandNo           String         @unique
  state              DemandState    @default(SUBMITTED)
  departmentTagId    String?
  requestedById      String
  startedById        String?
  closedById         String?
  cancelledById      String?
  remarks            String?
  requestedAt        DateTime       @default(now())
  startedAt          DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  departmentTag      DepartmentTag? @relation(fields: [departmentTagId], references: [id], onDelete: SetNull)
  requestedBy        User           @relation("DemandRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  startedBy          User?          @relation("DemandStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  closedBy           User?          @relation("DemandClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  cancelledBy        User?          @relation("DemandCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines              DemandLine[]
  issues             DemandIssue[]

  @@index([state, requestedAt])
  @@index([requestedById])
  @@index([requestedById, requestedAt])
  @@map("demands")
}

model DemandLine {
  id                             String                   @id @default(cuid())
  demandId                       String
  itemId                         String?
  projectTagId                   String?
  suggestedCategoryId            String?
  procurementType                ProcurementType?
  vendorId                       String?
  itemCodeSnapshot               String?
  title                          String
  description                    String?
  unit                           String                   @default("pcs")
  requiredQuantity               Decimal                  @db.Decimal(18, 6)
  approvedQuantity               Decimal?                 @db.Decimal(18, 6)
  approvedFromStockQuantity      Decimal?                 @db.Decimal(18, 6)
  approvedForProcurementQuantity Decimal?                 @db.Decimal(18, 6)
  approvedById                   String?
  approvedAt                     DateTime?
  approvalRemarks                String?
  remarks                        String?
  sortOrder                      Int                      @default(0)
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  demand                         Demand                   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  item                           Item?                    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  projectTag                     ProjectTag?              @relation(fields: [projectTagId], references: [id], onDelete: SetNull)
  suggestedCategory              ItemCategory?            @relation("SuggestedDemandCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  vendor                         Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  approvedBy                     User?                    @relation("DemandLineApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  reservations                   DemandReservationEntry[]
  cancellations                  DemandLineCancellation[]
  issueLines                     DemandIssueLine[]
  approvalRevisions              DemandApprovalRevision[]
  purchaseLinks                  DemandPurchaseLink[]

  @@index([demandId, sortOrder])
  @@index([itemId])
  @@index([projectTagId])
  @@index([suggestedCategoryId])
  @@index([approvedById])
  @@map("demand_lines")
}

model DemandReservationEntry {
  id           String               @id @default(cuid())
  demandLineId String
  type         ReservationEntryType
  quantity     Decimal              @db.Decimal(18, 6)
  sourceId     String               @unique
  createdById  String
  remarks      String?
  createdAt    DateTime             @default(now())
  demandLine   DemandLine           @relation(fields: [demandLineId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([demandLineId, createdAt])
  @@map("demand_reservation_entries")
}

model DemandLineCancellation {
  id           String     @id @default(cuid())
  demandLineId String
  quantity     Decimal    @db.Decimal(18, 6)
  reason       String
  sourceId     String     @unique
  createdById  String
  createdAt    DateTime   @default(now())
  demandLine   DemandLine @relation(fields: [demandLineId], references: [id], onDelete: Restrict)
  createdBy    User       @relation("CancellationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([demandLineId, createdAt])
  @@map("demand_line_cancellations")
}

model DemandIssue {
  id             String            @id @default(cuid())
  issueNo        String            @unique @map("allocationNo")
  demandId       String
  postedById     String
  idempotencyKey String?           @unique
  remarks        String?
  postedAt       DateTime          @default(now())
  createdAt      DateTime          @default(now())
  demand         Demand            @relation(fields: [demandId], references: [id], onDelete: Restrict)
  postedBy       User              @relation("IssuePostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines          DemandIssueLine[]

  @@index([demandId, postedAt])
  @@map("demand_allocations")
}

model DemandIssueLine {
  id           String             @id @default(cuid())
  issueId      String             @map("allocationId")
  demandLineId String
  itemId       String
  quantity     Decimal            @db.Decimal(18, 6)
  remarks      String?
  createdAt    DateTime           @default(now())
  issue        DemandIssue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  demandLine   DemandLine         @relation(fields: [demandLineId], references: [id], onDelete: Restrict)
  item         Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  returnLines  DemandReturnLine[]

  @@index([issueId])
  @@index([demandLineId])
  @@map("demand_allocation_lines")
}

model DemandReturn {
  id             String             @id @default(cuid())
  returnNo       String             @unique
  postedById     String
  idempotencyKey String?            @unique
  reason         String?
  remarks        String?
  postedAt       DateTime           @default(now())
  createdAt      DateTime           @default(now())
  postedBy       User               @relation("ReturnPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines          DemandReturnLine[]

  @@map("demand_returns")
}

model DemandReturnLine {
  id               String                  @id @default(cuid())
  returnId         String
  issueLineId      String                  @map("allocationLineId")
  itemId           String
  quantity         Decimal                 @db.Decimal(18, 6)
  disposition      ReturnDisposition       @default(REPLACEMENT_REQUIRED)
  remarks          String?
  createdAt        DateTime                @default(now())
  demandReturn     DemandReturn            @relation(fields: [returnId], references: [id], onDelete: Cascade)
  issueLine        DemandIssueLine         @relation(fields: [issueLineId], references: [id], onDelete: Restrict)
  item             Item                    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  approvalRevision DemandApprovalRevision?

  @@index([issueLineId])
  @@map("demand_return_lines")
}

model DemandApprovalRevision {
  id                          String                     @id @default(cuid())
  demandLineId                String
  type                        DemandApprovalRevisionType
  approvedQuantityDelta       Decimal                    @db.Decimal(18, 6)
  fromStockQuantityDelta      Decimal                    @db.Decimal(18, 6)
  forProcurementQuantityDelta Decimal                    @db.Decimal(18, 6)
  returnLineId                String?                    @unique
  sourceId                    String                     @unique
  reason                      String
  createdById                 String
  createdAt                   DateTime                   @default(now())
  demandLine                  DemandLine                 @relation(fields: [demandLineId], references: [id], onDelete: Restrict)
  returnLine                  DemandReturnLine?          @relation(fields: [returnLineId], references: [id], onDelete: Restrict)
  createdBy                   User                       @relation("ApprovalRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([demandLineId, createdAt])
  @@map("demand_approval_revisions")
}

model InventoryLedgerEntry {
  id           String                   @id @default(cuid())
  itemId       String
  type         InventoryLedgerEntryType
  quantity     Decimal                  @db.Decimal(18, 6)
  onHandAfter  Decimal                  @db.Decimal(18, 6)
  sourceType   String
  sourceId     String
  sourceLineId String
  actorId      String
  remarks      String?
  occurredAt   DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  item         Item                     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actor        User                     @relation("LedgerActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceLineId])
  @@index([itemId, occurredAt])
  @@map("inventory_ledger_entries")
}

model PurchaseRequest {
  id              String                @id @default(cuid())
  requestNo       String                @unique
  status          PurchaseRequestStatus @default(BACKLOG)
  vendorId        String?
  trackingNumber  String?
  boxNumber       String?
  shippingDetails String?
  remarks         String?
  createdById     String
  idempotencyKey  String?               @unique
  submittedAt     DateTime?
  orderedAt       DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  vendor          Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy       User                  @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines           PurchaseRequestLine[]
  receipts        GoodsReceipt[]
  attachments     Attachment[]

  @@index([status])
  @@index([status, createdAt])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String               @id @default(cuid())
  purchaseRequestId String
  itemId            String
  type              ProcurementType
  quantity          Decimal              @db.Decimal(18, 6)
  remarks           String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  purchaseRequest   PurchaseRequest      @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  item              Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  demandLinks       DemandPurchaseLink[]
  receiptLines      GoodsReceiptLine[]

  @@index([purchaseRequestId])
  @@index([itemId])
  @@map("purchase_request_lines")
}

model DemandPurchaseLink {
  id                    String              @id @default(cuid())
  purchaseRequestLineId String
  demandLineId          String
  quantity              Decimal             @db.Decimal(18, 6)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  purchaseRequestLine   PurchaseRequestLine @relation(fields: [purchaseRequestLineId], references: [id], onDelete: Cascade)
  demandLine            DemandLine          @relation(fields: [demandLineId], references: [id], onDelete: Restrict)

  @@unique([purchaseRequestLineId, demandLineId])
  @@index([demandLineId])
  @@map("demand_purchase_links")
}

model GoodsReceipt {
  id                String             @id @default(cuid())
  receiptNo         String             @unique
  purchaseRequestId String
  postedById        String
  idempotencyKey    String?            @unique
  remarks           String?
  postedAt          DateTime           @default(now())
  createdAt         DateTime           @default(now())
  purchaseRequest   PurchaseRequest    @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  postedBy          User               @relation("ReceiptPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines             GoodsReceiptLine[]
  attachments       Attachment[]

  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                    String              @id @default(cuid())
  receiptId             String
  purchaseRequestLineId String
  itemId                String
  quantity              Decimal             @db.Decimal(18, 6)
  unitCost              Decimal?            @db.Decimal(18, 4)
  remarks               String?
  createdAt             DateTime            @default(now())
  receipt               GoodsReceipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseRequestLine   PurchaseRequestLine @relation(fields: [purchaseRequestLineId], references: [id], onDelete: Restrict)
  item                  Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([purchaseRequestLineId])
  @@map("goods_receipt_lines")
}

model InventoryAdjustment {
  id             String                    @id @default(cuid())
  adjustmentNo   String                    @unique
  postedById     String
  idempotencyKey String?                   @unique
  reason         String
  remarks        String?
  postedAt       DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  postedBy       User                      @relation("AdjustmentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines          InventoryAdjustmentLine[]

  @@map("inventory_adjustments")
}

model InventoryAdjustmentLine {
  id           String              @id @default(cuid())
  adjustmentId String
  itemId       String
  quantity     Decimal             @db.Decimal(18, 6)
  remarks      String?
  createdAt    DateTime            @default(now())
  adjustment   InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item         Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("inventory_adjustment_lines")
}

model Attachment {
  id                String           @id @default(cuid())
  purchaseRequestId String?
  goodsReceiptId    String?
  kind              AttachmentKind   @default(OTHER)
  fileName          String
  contentType       String
  sizeBytes         Int
  data              Bytes
  uploadedById      String
  createdAt         DateTime         @default(now())
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  goodsReceipt      GoodsReceipt?    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  uploadedBy        User             @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("attachments")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  userName       String?
  action         String
  entityType     String?
  entityId       String?
  rootEntityType String?
  rootEntityId   String?
  details        String?
  metadata       Json?
  ipAddress      String?
  date           DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([entityType, entityId, date])
  @@index([rootEntityType, rootEntityId, date])
  @@map("audit_logs")
}

// Cargo owns shipment journeys. Packages are physical cartons; every package
// belongs to exactly one shipment, including when it is the only carton.
model CargoForwarder {
  id             String                 @id @default(cuid())
  name           String
  normalizedName String                 @unique
  contactPerson  String?
  phone          String?
  email          String?
  notes          String?
  status         RecordStatus           @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  warehouses     CargoSourceWarehouse[]
  shipments      CargoShipment[]

  @@map("cargo_forwarders")
}

model CargoSourceWarehouse {
  id             String          @id @default(cuid())
  forwarderId    String
  name           String
  normalizedName String
  address        String?
  notes          String?
  status         RecordStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  forwarder      CargoForwarder  @relation(fields: [forwarderId], references: [id], onDelete: Restrict)
  shipments      CargoShipment[]

  @@unique([forwarderId, normalizedName])
  @@unique([id, forwarderId])
  @@map("cargo_source_warehouses")
}

model CargoCourier {
  id             String             @id @default(cuid())
  name           String
  normalizedName String             @unique
  code           String?            @unique
  phone          String?
  website        String?
  notes          String?
  status         RecordStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  trackingLegs   CargoTrackingLeg[]

  @@map("cargo_couriers")
}

model CargoShipment {
  id                String                @id @default(cuid())
  shipmentNo        String                @unique
  route             CargoRoute
  forwarderId       String?
  sourceWarehouseId String?
  createdById       String
  notes             String?
  status            RecordStatus          @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  forwarder         CargoForwarder?       @relation(fields: [forwarderId], references: [id], onDelete: Restrict)
  sourceWarehouse   CargoSourceWarehouse? @relation(fields: [sourceWarehouseId, forwarderId], references: [id, forwarderId], onDelete: Restrict)
  createdBy         User                  @relation("CargoShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  packages          CargoPackage[]
  milestones        CargoMilestone[]
  trackingLegs      CargoTrackingLeg[]
  invoices          CargoInvoice[]
  charges           CargoCharge[]
  files             CargoFile[]
  legacyEvents      CargoLegacyEvent[]

  @@index([forwarderId])
  @@index([sourceWarehouseId])
  @@index([status, createdAt])
  @@map("cargo_shipments")
}

model CargoPackage {
  id             String                    @id @default(cuid())
  packageNo      String                    @unique
  shipmentId     String
  vendorId       String?
  weight         Decimal?                  @db.Decimal(12, 3)
  verifiedWeight Decimal?                  @db.Decimal(12, 3)
  length         Decimal?                  @db.Decimal(12, 2)
  width          Decimal?                  @db.Decimal(12, 2)
  height         Decimal?                  @db.Decimal(12, 2)
  notes          String?
  status         RecordStatus              @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  shipment       CargoShipment             @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  vendor         Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items          CargoPackageItem[]
  invoices       CargoInvoice[]
  charges        CargoCharge[]
  files          CargoFile[]
  legacyEvents   CargoLegacyEvent[]
  orderLinks     ProcurementOrderPackage[]

  @@unique([id, shipmentId])
  @@index([shipmentId])
  @@index([vendorId])
  @@index([status, createdAt])
  @@map("cargo_packages")
}

model CargoPackageItem {
  id          String       @id @default(cuid())
  packageId   String
  description String
  quantity    Decimal      @db.Decimal(18, 3)
  notes       String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  package     CargoPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([packageId, sortOrder])
  @@map("cargo_package_items")
}

model CargoMilestone {
  id         String        @id @default(cuid())
  shipmentId String
  sequence   Int
  stage      CargoStage
  occurredAt DateTime
  location   String?
  remarks    String?
  postedById String?
  createdAt  DateTime      @default(now())
  shipment   CargoShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  postedBy   User?         @relation("CargoMilestonePostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  @@unique([shipmentId, sequence])
  @@index([stage, occurredAt])
  @@map("cargo_milestones")
}

model CargoTrackingLeg {
  id             String         @id @default(cuid())
  shipmentId     String
  sequence       Int
  kind           CargoLegKind
  courierId      String?
  trackingNumber String?
  dispatchedAt   DateTime?
  arrivedAt      DateTime?
  remarks        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  shipment       CargoShipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  courier        CargoCourier?  @relation(fields: [courierId], references: [id], onDelete: Restrict)
  invoices       CargoInvoice[]
  charges        CargoCharge[]

  @@unique([shipmentId, sequence])
  @@unique([id, shipmentId])
  @@index([courierId])
  @@index([trackingNumber])
  @@map("cargo_tracking_legs")
}

model CargoInvoice {
  id            String            @id @default(cuid())
  shipmentId    String
  packageId     String?
  trackingLegId String?
  invoiceNo     String?
  sourceName    String?
  invoiceDate   DateTime?
  totalAmount   Decimal?          @db.Decimal(18, 4)
  currency      String            @default("PKR") @db.VarChar(3)
  notes         String?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  shipment      CargoShipment     @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  package       CargoPackage?     @relation(fields: [packageId, shipmentId], references: [id, shipmentId], onDelete: Restrict)
  trackingLeg   CargoTrackingLeg? @relation(fields: [trackingLegId, shipmentId], references: [id, shipmentId], onDelete: Restrict)
  createdBy     User              @relation("CargoInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  charges       CargoCharge[]
  files         CargoFile[]

  @@unique([id, shipmentId])
  @@index([shipmentId])
  @@index([packageId])
  @@index([trackingLegId])
  @@map("cargo_invoices")
}

model CargoCharge {
  id            String              @id @default(cuid())
  shipmentId    String
  packageId     String?
  trackingLegId String?
  invoiceId     String?
  category      CargoChargeCategory
  amount        Decimal             @db.Decimal(18, 4)
  currency      String              @db.VarChar(3)
  pkrEquivalent Decimal?            @db.Decimal(18, 4)
  pkrNote       String?
  remarks       String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  shipment      CargoShipment       @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  package       CargoPackage?       @relation(fields: [packageId, shipmentId], references: [id, shipmentId], onDelete: Restrict)
  trackingLeg   CargoTrackingLeg?   @relation(fields: [trackingLegId, shipmentId], references: [id, shipmentId], onDelete: Restrict)
  invoice       CargoInvoice?       @relation(fields: [invoiceId, shipmentId], references: [id, shipmentId], onDelete: Restrict)
  createdBy     User                @relation("CargoChargeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([packageId])
  @@index([trackingLegId])
  @@index([invoiceId])
  @@map("cargo_charges")
}

model CargoFile {
  id           String        @id @default(cuid())
  shipmentId   String
  packageId    String?
  invoiceId    String?
  kind         CargoFileKind
  fileName     String
  contentType  String
  sizeBytes    Int
  sha256       String
  data         Bytes
  uploadedById String
  createdAt    DateTime      @default(now())
  shipment     CargoShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  package      CargoPackage? @relation(fields: [packageId, shipmentId], references: [id, shipmentId], onDelete: Restrict)
  invoice      CargoInvoice? @relation(fields: [invoiceId, shipmentId], references: [id, shipmentId], onDelete: Restrict)
  uploadedBy   User          @relation("CargoFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([shipmentId, kind])
  @@index([packageId])
  @@index([invoiceId])
  @@map("cargo_files")
}

// Historical source events are kept verbatim. They do not independently
// advance a Cargo shipment's canonical journey stage.
model CargoLegacyEvent {
  id           String        @id
  shipmentId   String
  packageId    String
  rawStatus    String
  description  String?
  location     String?
  sourceUserId String?
  occurredAt   DateTime
  shipment     CargoShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  package      CargoPackage  @relation(fields: [packageId, shipmentId], references: [id, shipmentId], onDelete: Restrict)

  @@index([shipmentId, occurredAt])
  @@map("cargo_legacy_events")
}

// The only authoritative correspondence between PakLogix IDs and Flux IDs.
// A null target and reviewReason is an explicit unresolved import item.
// Orders are generic supplier orders. Marketplace-specific fields are retained
// only as source provenance, so the same model supports direct and agent orders.
model ProcurementOrder {
  id             String                    @id @default(cuid())
  source         String
  orderNo        String
  status         ProcurementOrderStatus    @default(DRAFT)
  sourceStatus   String?
  vendorId       String?
  supplierName   String
  submittedAt    DateTime?
  currency       String                    @default("PKR") @db.VarChar(3)
  paidAmount     Decimal?                  @db.Decimal(14, 4)
  shippingAmount Decimal?                  @db.Decimal(14, 4)
  courierName    String?
  trackingNumber String?
  notes          String?
  sourceFileName String?
  sourcePayload  Json?
  createdById    String
  statusRecord   RecordStatus              @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  vendor         Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation("ProcurementOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines          ProcurementOrderLine[]
  packageLinks   ProcurementOrderPackage[]

  @@unique([source, orderNo])
  @@index([status, submittedAt])
  @@index([vendorId])
  @@index([trackingNumber])
  @@map("procurement_orders")
}

model ProcurementOrderPackage {
  id         String           @id @default(cuid())
  orderId    String
  packageId  String
  remarks    String?
  linkedById String
  createdAt  DateTime         @default(now())
  order      ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  package    CargoPackage     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  linkedBy   User             @relation("ProcurementOrderPackageLinkedBy", fields: [linkedById], references: [id], onDelete: Restrict)

  @@unique([orderId, packageId])
  @@index([packageId])
  @@index([orderId, createdAt])
  @@map("procurement_order_packages")
}

model ProcurementOrderLine {
  id          String           @id @default(cuid())
  orderId     String
  lineNo      Int
  itemId      String?
  description String
  productUrl  String?
  variant     String?
  quantity    Decimal          @db.Decimal(14, 3)
  unitPrice   Decimal?         @db.Decimal(14, 4)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  order       ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  item        Item?            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([orderId, lineNo])
  @@index([itemId])
  @@map("procurement_order_lines")
}

model CargoImportRecord {
  sourceType   String
  sourceId     String
  sourceHash   String   @db.VarChar(64)
  targetType   String?
  targetId     String?
  sourceFacts  Json?
  reviewReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([sourceType, sourceId])
  @@index([reviewReason])
  @@map("cargo_import_records")
}
