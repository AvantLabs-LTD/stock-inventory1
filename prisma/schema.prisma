generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── CORE MODELS ────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   @default("VIEWER")
  status        String   @default("ACTIVE")
  phone         String?
  avatar        String?
  departmentId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department        Department?          @relation(fields: [departmentId], references: [id])
  issuedItems       InventoryIssue[]
  requestedItems    InventoryRequest[]
  receivedItems     GoodsReceived[]
  adjustedItems     StockAdjustment[]
  auditLogs         AuditLog[]
  reservationsBy    ReservedInventory[]
  releasedItems     ReservedInventory[] @relation("ReleasedBy")
  returnedItems     InventoryReturn[]
  createdStocks      OpeningStock[]
  deletedStocks      OpeningStock[] @relation("DeletedBy")
  ledgerEntries      StockLedger[]
  importBatches     ImportBatch[]
  createdRequisitions MaterialRequisition[]
  approvedRequisitions MaterialRequisition[] @relation("ApprovedByUser")

  @@index([email])
  @@index([role])
  @@index([departmentId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  headName    String?
  phone       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  projects  Project[]
  issues    InventoryIssue[]
  requests  InventoryRequest[]
  returns   InventoryReturn[]
  requisitions MaterialRequisition[]

  @@index([name])
}

model Project {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  departmentId  String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department   Department          @relation(fields: [departmentId], references: [id])
  issues       InventoryIssue[]
  requests     InventoryRequest[]
  reservations ReservedInventory[]
  returns      InventoryReturn[]
  requisitions MaterialRequisition[]

  @@index([departmentId])
  @@index([status])
}

// ─── INVENTORY MASTER ───────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  parentId    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  goodsReceived GoodsReceived[]
  openingStocks OpeningStock[]

  @@index([name])
}

model Product {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  sku             String   @unique
  parentProductId String?
  variantName     String?
  categoryId      String?
  supplierId      String?
  manufacturer    String?
  modelNumber     String?
  brand           String?
  barcode         String?
  qrCode          String?
  size            String?
  length          String?
  color           String?
  unit            String   @default("pcs")
  image           String?
  picture         String?
  datasheet       String?
  description     String?
  storageLocation String?
  minimumStock    Int      @default(0)
  maximumStock    Int      @default(0)
  reorderLevel    Int      @default(0)
  unitCost        Float    @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime  @updatedAt

  parent          Product?              @relation("ProductVariant", fields: [parentProductId], references: [id])
  variants        Product[]              @relation("ProductVariant")
  category        Category?              @relation(fields: [categoryId], references: [id])
  supplier        Supplier?              @relation(fields: [supplierId], references: [id])
  transactions   InventoryTransaction[]
  issues         InventoryIssue[]
  reservations   ReservedInventory[]
  requests       InventoryRequest[]
  goodsReceived  GoodsReceived[]
  requisitionItems RequisitionItem[]
  returns        InventoryReturn[]
  adjustments    StockAdjustment[]
  openingStocks  OpeningStock[]
  projectQtys   ProductProjectQty[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([status])
  @@index([sku])
  @@index([parentProductId])
  @@index([barcode])
}

// ─── STOCK LEDGER (Live Transaction History) ───────────────────────────────

model StockLedger {
  id              String   @id @default(cuid())
  openingStockId  String
  transactionType String   // OPENING, GOODS_RECEIVED, ISSUED, RETURNED, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT_IN, ADJUSTMENT_OUT, DAMAGED, SCRAPPED, RESERVED, RELEASED
  quantity        Int
  oldStock        Int
  newStock        Int
  userId          String
  projectId       String?
  warehouse       String?
  remarks         String?
  referenceId     String?
  createdAt       DateTime @default(now())

  openingStock  OpeningStock @relation(fields: [openingStockId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])

  @@index([openingStockId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([userId])
}

// ─── OPENING STOCK (Live Inventory Register) ────────────────────────────────

model OpeningStock {
  id                String    @id @default(cuid())
  productId         String
  warehouse         String?
  storageLocation   String?
  quantity          Int
  unitCost          Float     @default(0)
  inventoryValue    Float     @default(0)
  batchNumber       String?
  serialNumber      String?
  expiryDate        DateTime?
  supplierId        String?
  purchaseReference String?
  invoiceNumber     String?
  receivedDate      DateTime?
  openingDate       DateTime  @default(now())
  remarks           String?
  internalNotes     String?
  importBatchId     String?
  status            String    @default("ACTIVE")
  deletedAt         DateTime?
  deletedBy         String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Live stock totals
  receivedQty       Int       @default(0)
  issuedQty         Int       @default(0)
  returnedQty       Int       @default(0)
  reservedQty       Int       @default(0)
  damagedQty        Int       @default(0)
  transferredInQty  Int       @default(0)
  transferredOutQty Int       @default(0)
  currentStock      Int       @default(0)
  availableStock    Int       @default(0)
  lastTransactionAt DateTime?

  product       Product               @relation(fields: [productId], references: [id])
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])
  deletedByUser User?                 @relation("DeletedBy", fields: [deletedBy], references: [id])
  importBatch   ImportBatch?          @relation(fields: [importBatchId], references: [id])
  ledger        StockLedger[]
  customValues  OpeningStockCustomValue[]

  @@index([productId])
  @@index([warehouse])
  @@index([supplierId])
  @@index([status])
  @@index([openingDate])
  @@index([importBatchId])
}

// ─── IMPORT BATCH ──────────────────────────────────────────────────────────

model ImportBatch {
  id             String   @id @default(cuid())
  fileName       String
  sheetName      String?
  totalRows      Int      @default(0)
  imported       Int      @default(0)
  updated        Int      @default(0)
  skipped        Int      @default(0)
  errorCount     Int      @default(0)
  warningCount   Int      @default(0)
  durationMs     Int      @default(0)
  status         String   @default("COMPLETED")
  columnMapping  String?
  errorReport    String?
  importedById   String
  createdAt      DateTime @default(now())

  importedBy    User           @relation(fields: [importedById], references: [id])
  openingStocks OpeningStock[]

  @@index([importedById])
  @@index([status])
  @@index([createdAt])
}

// ─── DYNAMIC CUSTOM FIELDS ────────────────────────────────────────────────

model CustomField {
  id        String   @id @default(cuid())
  name      String   @unique
  fieldType String   @default("TEXT")
  source    String   @default("IMPORT")
  createdAt DateTime @default(now())

  values OpeningStockCustomValue[]

  @@index([source])
}

model OpeningStockCustomValue {
  id              String @id @default(cuid())
  openingStockId  String
  customFieldId   String
  value           String

  openingStock OpeningStock @relation(fields: [openingStockId], references: [id], onDelete: Cascade)
  customField  CustomField  @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([openingStockId, customFieldId])
  @@index([openingStockId])
  @@index([customFieldId])
}

// ─── PROJECT QUANTITY FIELDS (Dynamic per-product project tracking) ───────

model ProjectField {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  productQtys ProductProjectQty[]
}

model ProductProjectQty {
  id              String @id @default(cuid())
  productId       String
  projectFieldId  String
  requiredQty     Int    @default(0)
  batchQty        Int    @default(0)
  reservedQty     Int    @default(0)
  consumedQty     Int    @default(0)
  orderedQty      Int    @default(0)
  toBeUsed        Int    @default(0)
  remarks         String?

  product     Product      @relation(fields: [productId], references: [id])
  projectField ProjectField @relation(fields: [projectFieldId], references: [id])

  @@unique([productId, projectFieldId])
  @@index([productId])
  @@index([projectFieldId])
}

// ─── INVENTORY TRANSACTIONS (Legacy - kept for backward compat) ───────────

model InventoryTransaction {
  id        String   @id @default(cuid())
  productId String
  type      String
  quantity  Int
  unitCost  Float?
  reference String?
  remarks   String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([date])
}

model GoodsReceived {
  id                String   @id @default(cuid())
  productId         String
  supplierId        String?
  source            String?
  purchaseReference String?
  invoiceNumber     String?
  batchNumber       String?
  warehouse         String?
  quantity          Int
  unitCost          Float
  date              DateTime @default(now())
  receivedBy        String
  remarks           String?
  createdAt         DateTime @default(now())

  product        Product   @relation(fields: [productId], references: [id])
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  receivedByUser User      @relation(fields: [receivedBy], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@index([date])
}

model InventoryIssue {
  id            String   @id @default(cuid())
  productId     String
  departmentId  String
  projectId     String
  issuedBy      String
  employeeName  String
  productionHall String?
  quantity      Int
  remarks       String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  product      Product    @relation(fields: [productId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  project      Project    @relation(fields: [projectId], references: [id])
  issuedByUser User       @relation(fields: [issuedBy], references: [id])
  returns      InventoryReturn[] @relation("IssueReturn")

  @@index([productId])
  @@index([departmentId])
  @@index([projectId])
  @@index([date])
}

model InventoryReturn {
  id            String   @id @default(cuid())
  returnNumber  String   @unique
  productId     String
  departmentId  String
  projectId     String
  relatedIssueId String?
  returnedBy    String
  employeeName  String
  quantity      Int
  reason        String?
  remarks       String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  product         Product          @relation(fields: [productId], references: [id])
  department      Department       @relation(fields: [departmentId], references: [id])
  project         Project          @relation(fields: [projectId], references: [id])
  relatedIssue    InventoryIssue?  @relation("IssueReturn", fields: [relatedIssueId], references: [id])
  returnedByUser  User             @relation(fields: [returnedBy], references: [id])

  @@index([productId])
  @@index([departmentId])
  @@index([projectId])
  @@index([date])
}

model ReservedInventory {
  id                  String    @id @default(cuid())
  productId           String
  projectId           String
  quantity            Int
  reason              String?
  status              String    @default("ACTIVE")
  reservedBy          String
  releasedBy          String?
  releasedAt          DateTime?
  expectedReleaseDate DateTime?
  remarks             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  product         Product           @relation(fields: [productId], references: [id])
  project         Project           @relation(fields: [projectId], references: [id])
  reservedByUser  User              @relation(fields: [reservedBy], references: [id])
  releasedByUser  User?             @relation("ReleasedBy", fields: [releasedBy], references: [id])

  @@index([productId])
  @@index([projectId])
  @@index([status])
}

model InventoryRequest {
  id            String   @id @default(cuid())
  productId     String
  departmentId  String
  projectId     String
  requestedBy   String
  employeeName  String
  quantity      Int
  approvedQty   Int      @default(0)
  priority      String   @default("MEDIUM")
  reason        String?
  status        String   @default("PENDING")
  approvedBy    String?
  approvedAt    DateTime?
  completedBy   String?
  completedAt   DateTime?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product          Product    @relation(fields: [productId], references: [id])
  department       Department @relation(fields: [departmentId], references: [id])
  project          Project    @relation(fields: [projectId], references: [id])
  requestedByUser  User       @relation(fields: [requestedBy], references: [id])

  @@index([productId])
  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
}

// ─── MATERIAL REQUISITION (Multi-item request form) ──────────────────────

model MaterialRequisition {
  id              String    @id @default(cuid())
  requisitionNo   String    @unique
  date            DateTime  @default(now())
  departmentId    String
  projectId       String
  requestedBy     String
  employeeName    String
  issuedByName    String?
  receivedByName  String?
  approvedBy      String?
  approvedAt      DateTime?
  completedBy     String?
  completedAt     DateTime?
  status          String    @default("PENDING")
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  department       Department        @relation(fields: [departmentId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id])
  requestedByUser  User              @relation(fields: [requestedBy], references: [id])
  approvedByUser   User?             @relation("ApprovedByUser", fields: [approvedBy], references: [id])
  items            RequisitionItem[]

  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@index([date])
}

model RequisitionItem {
  id              String   @id @default(cuid())
  requisitionId   String
  productId       String
  specDescription String?
  requiredQty     Int
  issuedQty       Int      @default(0)
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requisition MaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id])

  @@index([requisitionId])
  @@index([productId])
}

model StockAdjustment {
  id          String   @id @default(cuid())
  productId   String
  type        String
  quantity    Int
  reason      String?
  remarks     String?
  adjustedBy  String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  product         Product @relation(fields: [productId], references: [id])
  adjustedByUser  User    @relation(fields: [adjustedBy], references: [id])

  @@index([productId])
  @@index([type])
  @@index([date])
}

// ─── AUDIT LOG ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  date       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([date])
  @@index([entityType])
}

// ─── INVENTORY ITEMS (Live Stock Register) ───────────────────────────────

model InventoryItem {
  id            String   @id @default(cuid())
  itemName      String
  specification String
  unit          String   @default("pcs")
  quantity      Int      @default(0)
  issuedQty     Int      @default(0)
  reservedQty   Int      @default(0)
  returnedQty   Int      @default(0)
  damagedQty    Int      @default(0)
  minimumStock  Int      @default(0)
  unitCost      Float    @default(0)
  warehouse     String   @default("Main Warehouse")
  remarks       String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([itemName, specification, warehouse])
  @@index([itemName])
  @@index([specification])
  @@index([warehouse])
  @@index([status])
}
