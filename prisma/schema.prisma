generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ItemDiscipline {
  MECHANICAL
  ELECTRONICS
}

enum UserRole {
  SUPER_ADMIN
  INVENTORY_MANAGER
  PURCHASE_APPROVER
  USER
}

enum ProcurementType {
  FOREIGN_STANDARD
  FOREIGN_MANUFACTURED
  LOCAL_STANDARD
  LOCAL_MANUFACTURED
}

enum ItemCatalogueState {
  COMPLETE
  INCOMPLETE
}

enum DemandState {
  SUBMITTED
  ACTIVE
  CLOSED
  CANCELLED
}

enum ReservationEntryType {
  RESERVE
  RELEASE
}

enum InventoryLedgerEntryType {
  OPENING
  RECEIPT
  ISSUE
  RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum DemandApprovalRevisionType {
  MANAGER_ADJUSTMENT
  PROCUREMENT_TO_STOCK
  RETURN_NO_REPLACEMENT
  CANCELLATION
}

enum ReturnDisposition {
  REPLACEMENT_REQUIRED
  REDUCE_APPROVED_QUANTITY
}

enum PurchaseRequestStatus {
  BACKLOG
  PENDING_ORDER_APPROVAL
  ORDERED
  SHIPPED
  RECEIVED_IN_STORE
}

enum AttachmentKind {
  RECEIPT
  INVOICE
  QUOTATION
  SHIPPING_DOCUMENT
  OTHER
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique
  password             String
  name                 String
  status               String                   @default("ACTIVE")
  role                 UserRole                 @default(USER)
  phone                String?
  avatar               String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  itemsCreated         Item[]                   @relation("ItemCreatedBy")
  demandsRequested     Demand[]                 @relation("DemandRequestedBy")
  demandsStarted       Demand[]                 @relation("DemandStartedBy")
  demandsClosed        Demand[]                 @relation("DemandClosedBy")
  demandsCancelled     Demand[]                 @relation("DemandCancelledBy")
  reservationsCreated  DemandReservationEntry[] @relation("ReservationCreatedBy")
  cancellationsCreated DemandLineCancellation[] @relation("CancellationCreatedBy")
  demandLinesApproved  DemandLine[]             @relation("DemandLineApprovedBy")
  approvalRevisions    DemandApprovalRevision[] @relation("ApprovalRevisionCreatedBy")
  issuesPosted         DemandIssue[]            @relation("IssuePostedBy")
  returnsPosted        DemandReturn[]           @relation("ReturnPostedBy")
  ledgerEntries        InventoryLedgerEntry[]   @relation("LedgerActor")
  purchaseRequests     PurchaseRequest[]        @relation("PurchaseCreatedBy")
  receiptsPosted       GoodsReceipt[]           @relation("ReceiptPostedBy")
  adjustmentsPosted    InventoryAdjustment[]    @relation("AdjustmentPostedBy")
  attachmentsUploaded  Attachment[]             @relation("AttachmentUploadedBy")
  auditLogs            AuditLog[]
  accessGroups         UserAccessGroup[]
}

model Permission {
  key         String                  @id
  module      String
  description String
  groups      AccessGroupPermission[]

  @@map("permissions")
}

model AccessGroup {
  id          String                  @id
  name        String                  @unique
  description String
  isSystem    Boolean                 @default(false)
  permissions AccessGroupPermission[]
  users       UserAccessGroup[]

  @@map("access_groups")
}

model AccessGroupPermission {
  groupId       String
  permissionKey String
  group         AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([groupId, permissionKey])
  @@map("access_group_permissions")
}

model UserAccessGroup {
  userId  String
  groupId String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@map("user_access_groups")
}

model DepartmentTag {
  id             String       @id @default(cuid())
  name           String
  normalizedName String       @unique
  code           String?      @unique
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  demands        Demand[]

  @@index([name])
  @@map("department_tags")
}

model ProjectTag {
  id             String       @id @default(cuid())
  name           String
  normalizedName String       @unique
  code           String?      @unique
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  demandLines    DemandLine[]

  @@index([name])
  @@map("project_tags")
}

model ItemCategory {
  id             String         @id @default(cuid())
  name           String
  normalizedName String
  discipline     ItemDiscipline
  parentId       String?
  description    String?
  status         RecordStatus   @default(ACTIVE)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  parent         ItemCategory?  @relation("ItemCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       ItemCategory[] @relation("ItemCategoryTree")
  items          Item[]
  demandLines    DemandLine[]   @relation("SuggestedDemandCategory")

  @@unique([parentId, normalizedName])
  @@index([discipline, status, sortOrder])
  @@map("item_categories")
}

model Vendor {
  id               String            @id @default(cuid())
  name             String
  normalizedName   String            @unique
  contactPerson    String?
  phone            String?
  email            String?
  address          String?
  remarks          String?
  status           RecordStatus      @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  demandLines      DemandLine[]
  purchaseRequests PurchaseRequest[]

  @@index([name])
  @@map("vendors")
}

model Item {
  id                     String                    @id @default(cuid())
  code                   String                    @unique
  title                  String
  discipline             ItemDiscipline
  categoryId             String?
  catalogueState         ItemCatalogueState        @default(COMPLETE)
  description            String?
  specification          String?
  manufacturerName       String?
  manufacturerPartNumber String?
  supplierPartNumber     String?
  function               String?
  link                   String?
  optionSelection        String?
  remarks                String?
  unit                   String                    @default("pcs")
  status                 RecordStatus              @default(ACTIVE)
  importSourceKey        String?                   @unique
  createdById            String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  category               ItemCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy              User?                     @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  balance                ItemBalance?
  demandLines            DemandLine[]
  issueLines             DemandIssueLine[]
  returnLines            DemandReturnLine[]
  ledgerEntries          InventoryLedgerEntry[]
  purchaseLines          PurchaseRequestLine[]
  receiptLines           GoodsReceiptLine[]
  adjustmentLines        InventoryAdjustmentLine[]

  @@index([title])
  @@index([categoryId, status])
  @@index([manufacturerPartNumber])
  @@index([supplierPartNumber])
  @@index([status])
  @@map("items")
}

model ItemBalance {
  itemId    String   @id
  onHand    Decimal  @default(0) @db.Decimal(18, 6)
  reserved  Decimal  @default(0) @db.Decimal(18, 6)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_balances")
}

model Demand {
  id                 String         @id @default(cuid())
  demandNo           String         @unique
  state              DemandState    @default(SUBMITTED)
  departmentTagId    String?
  requestedById      String
  startedById        String?
  closedById         String?
  cancelledById      String?
  remarks            String?
  requestedAt        DateTime       @default(now())
  startedAt          DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  departmentTag      DepartmentTag? @relation(fields: [departmentTagId], references: [id], onDelete: SetNull)
  requestedBy        User           @relation("DemandRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  startedBy          User?          @relation("DemandStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  closedBy           User?          @relation("DemandClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  cancelledBy        User?          @relation("DemandCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines              DemandLine[]
  issues             DemandIssue[]

  @@index([state, requestedAt])
  @@index([requestedById])
  @@map("demands")
}

model DemandLine {
  id                             String                   @id @default(cuid())
  demandId                       String
  itemId                         String?
  projectTagId                   String?
  suggestedCategoryId            String?
  procurementType                ProcurementType?
  vendorId                       String?
  itemCodeSnapshot               String?
  title                          String
  description                    String?
  unit                           String                   @default("pcs")
  requiredQuantity               Decimal                  @db.Decimal(18, 6)
  approvedQuantity               Decimal?                 @db.Decimal(18, 6)
  approvedFromStockQuantity      Decimal?                 @db.Decimal(18, 6)
  approvedForProcurementQuantity Decimal?                 @db.Decimal(18, 6)
  approvedById                   String?
  approvedAt                     DateTime?
  approvalRemarks                String?
  remarks                        String?
  sortOrder                      Int                      @default(0)
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  demand                         Demand                   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  item                           Item?                    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  projectTag                     ProjectTag?              @relation(fields: [projectTagId], references: [id], onDelete: SetNull)
  suggestedCategory              ItemCategory?            @relation("SuggestedDemandCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  vendor                         Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  approvedBy                     User?                    @relation("DemandLineApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  reservations                   DemandReservationEntry[]
  cancellations                  DemandLineCancellation[]
  issueLines                     DemandIssueLine[]
  approvalRevisions              DemandApprovalRevision[]
  purchaseLinks                  DemandPurchaseLink[]

  @@index([demandId, sortOrder])
  @@index([itemId])
  @@index([projectTagId])
  @@index([suggestedCategoryId])
  @@index([approvedById])
  @@map("demand_lines")
}

model DemandReservationEntry {
  id           String               @id @default(cuid())
  demandLineId String
  type         ReservationEntryType
  quantity     Decimal              @db.Decimal(18, 6)
  sourceId     String               @unique
  createdById  String
  remarks      String?
  createdAt    DateTime             @default(now())
  demandLine   DemandLine           @relation(fields: [demandLineId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([demandLineId, createdAt])
  @@map("demand_reservation_entries")
}

model DemandLineCancellation {
  id           String     @id @default(cuid())
  demandLineId String
  quantity     Decimal    @db.Decimal(18, 6)
  reason       String
  sourceId     String     @unique
  createdById  String
  createdAt    DateTime   @default(now())
  demandLine   DemandLine @relation(fields: [demandLineId], references: [id], onDelete: Restrict)
  createdBy    User       @relation("CancellationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([demandLineId, createdAt])
  @@map("demand_line_cancellations")
}

model DemandIssue {
  id             String            @id @default(cuid())
  issueNo        String            @unique @map("allocationNo")
  demandId       String
  postedById     String
  idempotencyKey String?           @unique
  remarks        String?
  postedAt       DateTime          @default(now())
  createdAt      DateTime          @default(now())
  demand         Demand            @relation(fields: [demandId], references: [id], onDelete: Restrict)
  postedBy       User              @relation("IssuePostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines          DemandIssueLine[]

  @@index([demandId, postedAt])
  @@map("demand_allocations")
}

model DemandIssueLine {
  id           String             @id @default(cuid())
  issueId      String             @map("allocationId")
  demandLineId String
  itemId       String
  quantity     Decimal            @db.Decimal(18, 6)
  remarks      String?
  createdAt    DateTime           @default(now())
  issue        DemandIssue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  demandLine   DemandLine         @relation(fields: [demandLineId], references: [id], onDelete: Restrict)
  item         Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  returnLines  DemandReturnLine[]

  @@index([issueId])
  @@index([demandLineId])
  @@map("demand_allocation_lines")
}

model DemandReturn {
  id             String             @id @default(cuid())
  returnNo       String             @unique
  postedById     String
  idempotencyKey String?            @unique
  reason         String?
  remarks        String?
  postedAt       DateTime           @default(now())
  createdAt      DateTime           @default(now())
  postedBy       User               @relation("ReturnPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines          DemandReturnLine[]

  @@map("demand_returns")
}

model DemandReturnLine {
  id               String                  @id @default(cuid())
  returnId         String
  issueLineId      String                  @map("allocationLineId")
  itemId           String
  quantity         Decimal                 @db.Decimal(18, 6)
  disposition      ReturnDisposition       @default(REPLACEMENT_REQUIRED)
  remarks          String?
  createdAt        DateTime                @default(now())
  demandReturn     DemandReturn            @relation(fields: [returnId], references: [id], onDelete: Cascade)
  issueLine        DemandIssueLine         @relation(fields: [issueLineId], references: [id], onDelete: Restrict)
  item             Item                    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  approvalRevision DemandApprovalRevision?

  @@index([issueLineId])
  @@map("demand_return_lines")
}

model DemandApprovalRevision {
  id                          String                     @id @default(cuid())
  demandLineId                String
  type                        DemandApprovalRevisionType
  approvedQuantityDelta       Decimal                    @db.Decimal(18, 6)
  fromStockQuantityDelta      Decimal                    @db.Decimal(18, 6)
  forProcurementQuantityDelta Decimal                    @db.Decimal(18, 6)
  returnLineId                String?                    @unique
  sourceId                    String                     @unique
  reason                      String
  createdById                 String
  createdAt                   DateTime                   @default(now())
  demandLine                  DemandLine                 @relation(fields: [demandLineId], references: [id], onDelete: Restrict)
  returnLine                  DemandReturnLine?          @relation(fields: [returnLineId], references: [id], onDelete: Restrict)
  createdBy                   User                       @relation("ApprovalRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([demandLineId, createdAt])
  @@map("demand_approval_revisions")
}

model InventoryLedgerEntry {
  id           String                   @id @default(cuid())
  itemId       String
  type         InventoryLedgerEntryType
  quantity     Decimal                  @db.Decimal(18, 6)
  onHandAfter  Decimal                  @db.Decimal(18, 6)
  sourceType   String
  sourceId     String
  sourceLineId String
  actorId      String
  remarks      String?
  occurredAt   DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  item         Item                     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actor        User                     @relation("LedgerActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceLineId])
  @@index([itemId, occurredAt])
  @@map("inventory_ledger_entries")
}

model PurchaseRequest {
  id              String                @id @default(cuid())
  requestNo       String                @unique
  status          PurchaseRequestStatus @default(BACKLOG)
  vendorId        String?
  trackingNumber  String?
  boxNumber       String?
  shippingDetails String?
  remarks         String?
  createdById     String
  idempotencyKey  String?               @unique
  submittedAt     DateTime?
  orderedAt       DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  vendor          Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy       User                  @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines           PurchaseRequestLine[]
  receipts        GoodsReceipt[]
  attachments     Attachment[]

  @@index([status])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String               @id @default(cuid())
  purchaseRequestId String
  itemId            String
  type              ProcurementType
  quantity          Decimal              @db.Decimal(18, 6)
  remarks           String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  purchaseRequest   PurchaseRequest      @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  item              Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  demandLinks       DemandPurchaseLink[]
  receiptLines      GoodsReceiptLine[]

  @@index([purchaseRequestId])
  @@index([itemId])
  @@map("purchase_request_lines")
}

model DemandPurchaseLink {
  id                    String              @id @default(cuid())
  purchaseRequestLineId String
  demandLineId          String
  quantity              Decimal             @db.Decimal(18, 6)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  purchaseRequestLine   PurchaseRequestLine @relation(fields: [purchaseRequestLineId], references: [id], onDelete: Cascade)
  demandLine            DemandLine          @relation(fields: [demandLineId], references: [id], onDelete: Restrict)

  @@unique([purchaseRequestLineId, demandLineId])
  @@index([demandLineId])
  @@map("demand_purchase_links")
}

model GoodsReceipt {
  id                String             @id @default(cuid())
  receiptNo         String             @unique
  purchaseRequestId String
  postedById        String
  idempotencyKey    String?            @unique
  remarks           String?
  postedAt          DateTime           @default(now())
  createdAt         DateTime           @default(now())
  purchaseRequest   PurchaseRequest    @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  postedBy          User               @relation("ReceiptPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines             GoodsReceiptLine[]
  attachments       Attachment[]

  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                    String              @id @default(cuid())
  receiptId             String
  purchaseRequestLineId String
  itemId                String
  quantity              Decimal             @db.Decimal(18, 6)
  unitCost              Decimal?            @db.Decimal(18, 4)
  remarks               String?
  createdAt             DateTime            @default(now())
  receipt               GoodsReceipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseRequestLine   PurchaseRequestLine @relation(fields: [purchaseRequestLineId], references: [id], onDelete: Restrict)
  item                  Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([purchaseRequestLineId])
  @@map("goods_receipt_lines")
}

model InventoryAdjustment {
  id             String                    @id @default(cuid())
  adjustmentNo   String                    @unique
  postedById     String
  idempotencyKey String?                   @unique
  reason         String
  remarks        String?
  postedAt       DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  postedBy       User                      @relation("AdjustmentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines          InventoryAdjustmentLine[]

  @@map("inventory_adjustments")
}

model InventoryAdjustmentLine {
  id           String              @id @default(cuid())
  adjustmentId String
  itemId       String
  quantity     Decimal             @db.Decimal(18, 6)
  remarks      String?
  createdAt    DateTime            @default(now())
  adjustment   InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item         Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("inventory_adjustment_lines")
}

model Attachment {
  id                String           @id @default(cuid())
  purchaseRequestId String?
  goodsReceiptId    String?
  kind              AttachmentKind   @default(OTHER)
  fileName          String
  contentType       String
  sizeBytes         Int
  data              Bytes
  uploadedById      String
  createdAt         DateTime         @default(now())
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  goodsReceipt      GoodsReceipt?    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  uploadedBy        User             @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("attachments")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  date       DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("audit_logs")
}
